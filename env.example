# ARMoS Utilities - Environment Template
# Copy ke .env dan isi nilai sesuai server/lingkungan Anda:
#   cp env.example .env
#   nano .env

# ----- Database Utama (untuk menu umum) -----
DATABASE_MAIN_HOST=localhost
DATABASE_MAIN_PORT=5432
DATABASE_MAIN_NAME=armos
DATABASE_MAIN_USERNAME=armos
DATABASE_MAIN_PASS=your_password

# ----- Database Preprod (Ubah Order Data, Export CSV, Update Order on Route, dll) -----
DATABASE_PREPROD_HOST=preprod-db-host
DATABASE_PREPROD_PORT=5432
DATABASE_PREPROD_NAME=armos_preprod
DATABASE_PREPROD_USERNAME=armos
DATABASE_PREPROD_PASS=your_preprod_password

# ----- Database Production -----
DATABASE_PROD_HOST=prod-db-host
DATABASE_PROD_PORT=5432
DATABASE_PROD_NAME=armos_prod
DATABASE_PROD_USERNAME=armos
DATABASE_PROD_PASS=your_prod_password

# ----- Session & Login (wajib: set SECRET_KEY atau SUPABASE_KEY) -----
SECRET_KEY=your-flask-secret-key-min-32-chars
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ----- App -----
PORT=5000
LOG_LEVEL=INFO

# ----- Opsional: Sync Manager (jika pakai fitur Sync) -----
